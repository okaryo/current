{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Current",
  "version": "0.1.0",
  "identifier": "studio.okaryo.current",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Current",
        "width": 860,
        "height": 720,
        "minWidth": 860,
        "minHeight": 630
      },
      {
        "label": "quick-entry",
        "title": "Quick Entry",
        "url": "/quick-entry/",
        "width": 560,
        "height": 230,
        "minWidth": 420,
        "minHeight": 190,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyQUM1QTIzMDIyMzk0MzcKUldRM2xDTUNJMXFza2dnYVppVkYya0V2MnlYNGs2cjJUN1l0VGcyT2lreUh6bGF3NkhGaS9FdUgK",
      "endpoints": [
        "https://github.com/okaryo/current/releases/latest/download/latest.json"
      ]
    }
  }
}
